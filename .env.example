# Connexion MySQL - copier ce fichier en .env et renseigner les valeurs
MYSQL_HOST=192.168.10.21
MYSQL_PORT=3306
MYSQL_USER=wms_user
MYSQL_PASSWORD=
MYSQL_DATABASE=wms

# Dossier de stockage des sauvegardes generees
DOSSIER_SAUVEGARDES=sauvegardes

# Nombre de sauvegardes a conserver (rotation automatique)
NB_SAUVEGARDES_GARDER=7
