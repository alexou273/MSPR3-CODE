# ============================================================
# NTL-SysToolbox - Fichier de configuration
# Copier ce fichier en .env et renseigner les valeurs
# Ne jamais versionner le .env (contient des secrets)
# ============================================================

# --- Controleurs de domaine (Module Diagnostic) ---
DC1_IP=192.168.10.10
DC2_IP=192.168.10.11

# --- Connexion MySQL (Module Diagnostic + Module Sauvegarde) ---
MYSQL_HOST=192.168.10.21
MYSQL_PORT=3306
MYSQL_USER=wms_user
MYSQL_PASSWORD=
MYSQL_DATABASE=wms

# --- Dossiers de sortie ---
DOSSIER_SAUVEGARDES=sauvegardes
NB_SAUVEGARDES_GARDER=7
DOSSIER_LOGS=logs
